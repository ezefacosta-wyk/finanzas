# Configuración del bot de Telegram — copiá este archivo como .env y completalo.
# ⚠ Este archivo es sólo una plantilla y está en un repo público: NUNCA pongas valores reales acá.
#    El .env real queda sólo en tu PC (está en .gitignore) con permisos 600.

# Token que te da @BotFather (el nuevo, después de revocar el anterior)
BOT_TOKEN=PEGAR_EL_TOKEN_DE_BOTFATHER

# Cliente OAuth de Google Cloud (APIs y servicios → Credenciales)
GOOGLE_CLIENT_ID=40977181531-47pauk08197779rjmrccasm8omdpl5kk.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=COMPLETAR_DESDE_GOOGLE_CLOUD

# Tu ID de chat de Telegram (varios separados por coma). Vacío = el bot no atiende a nadie.
# Para saberlo: arrancá el bot y mandale /start; si no estás autorizado te responde tu ID.
ALLOWED_CHAT_IDS=

# ── Opcionales (los valores por defecto sirven para correrlo en tu PC) ──
# MODE=polling                                           # polling (PC) | webhook (servidor con URL pública)
# PORT=8080                                              # puerto local para el regreso de Google
# REDIRECT_URI=http://localhost:8080/oauth/callback      # debe estar autorizada en Google Cloud
# DATA_DIR=                                              # por defecto: carpeta data/ junto a bot.py
